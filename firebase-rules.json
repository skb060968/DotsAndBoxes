{
  "rules": {
    "dots-and-boxes-rooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null",

        "players": {
          "$playerId": {
            ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)"
          }
        },

        "game": {
          ".write": "auth != null"
        },

        "meta": {
          ".write": "auth != null"
        },

        "rankings": {
          ".write": "auth != null"
        }
      }
    }
  }
}
