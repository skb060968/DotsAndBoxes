{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": true,
        ".write": true,
        ".indexOn": ["code", "createdAt"],
        
        "id": {
          ".validate": "newData.isString()"
        },
        "code": {
          ".validate": "newData.isString() && newData.val().length === 4"
        },
        "hostId": {
          ".validate": "newData.isString()"
        },
        "maxPlayers": {
          ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 4"
        },
        "currentPlayers": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'playing' || newData.val() === 'finished')"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "players": {
          "$playerId": {
            ".validate": "newData.hasChildren(['id', 'name', 'avatar', 'playerNumber'])",
            "id": {
              ".validate": "newData.isString()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
            },
            "avatar": {
              ".validate": "newData.isString()"
            },
            "playerNumber": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "isHost": {
              ".validate": "newData.isBoolean()"
            },
            "lastActive": {
              ".validate": "newData.isNumber()"
            }
          }
        },
        "game": {
          "currentPlayer": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4"
          },
          "rows": {
            ".validate": "newData.isNumber() && newData.val() === 11"
          },
          "cols": {
            ".validate": "newData.isNumber() && newData.val() === 6"
          },
          "horizontalLines": {
            ".validate": "newData.hasChildren()"
          },
          "verticalLines": {
            ".validate": "newData.hasChildren()"
          },
          "boxes": {
            ".validate": "newData.hasChildren()"
          },
          "scores": {
            ".validate": "newData.hasChildren()"
          },
          "isGameOver": {
            ".validate": "newData.isBoolean()"
          },
          "winner": {
            ".validate": "!newData.exists() || newData.isNumber()"
          },
          "lastMove": {
            "type": {
              ".validate": "newData.isString() && (newData.val() === 'horizontal' || newData.val() === 'vertical')"
            },
            "row": {
              ".validate": "newData.isNumber()"
            },
            "col": {
              ".validate": "newData.isNumber()"
            },
            "player": {
              ".validate": "newData.isNumber()"
            },
            "timestamp": {
              ".validate": "newData.isNumber()"
            }
          }
        }
      }
    },
    
    "roomCodes": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "newData.isString()"
      }
    },
    
    "presence": {
      "$userId": {
        ".read": true,
        ".write": "$userId === auth.uid || !data.exists()",
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'online' || newData.val() === 'offline')"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "roomId": {
          ".validate": "!newData.exists() || newData.isString()"
        }
      }
    }
  }
}
